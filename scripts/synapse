#!/usr/bin/env zsh
# ─────────────────────────────────────────────────────────────────────────────
# Synapse management CLI
# Usage: ./scripts/synapse <command>
#
# Commands:
#   start    Load the launchd agent and start the daemon
#   stop     Unload the launchd agent and stop the daemon
#   restart  Stop then start
#   status   Show daemon status + snippet count
#   logs     Tail the daemon log (Ctrl+C to exit)
#   reset    Wipe the vector store (FAISS + SQLite) — use with caution!
#   install  Symlink this script to /usr/local/bin/synapse
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PLIST_SRC="$SCRIPT_DIR/com.synapse.daemon.plist"
PLIST_LABEL="com.synapse.daemon"
PLIST_DEST="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"
LOG_DIR="$HOME/Library/Logs/Synapse"
LOG_FILE="$LOG_DIR/daemon.log"
SOCKET="/tmp/synapse.sock"
PYTHON="$PROJECT_ROOT/.venv/bin/python"

# ── Colours ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}→${RESET} $*"; }
success() { echo -e "${GREEN}✓${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
error()   { echo -e "${RED}✗${RESET} $*" >&2; }

# ── Helpers ───────────────────────────────────────────────────────────────────

_is_running() {
    launchctl list "$PLIST_LABEL" &>/dev/null && [[ -S "$SOCKET" ]]
}

_ping_daemon() {
    "$PYTHON" -c "
import socket, json
try:
    fd = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    fd.settimeout(2)
    fd.connect('$SOCKET')
    fd.sendall(b'{\"action\":\"count\"}\n')
    data = b''
    while b'\n' not in data:
        chunk = fd.recv(4096)
        if not chunk: break
        data += chunk
    r = json.loads(data.strip())
    print(r.get('active_snippets', 0))
except Exception:
    print('?')
finally:
    fd.close()
" 2>/dev/null
}

# ── Commands ───────────────────────────────────────────────────────────────────

_user_domain() { echo "gui/$(id -u)"; }

cmd_start() {
    if _is_running; then
        warn "Daemon is already running."
        return
    fi
    info "Creating log directory..."
    mkdir -p "$LOG_DIR"

    info "Installing launchd agent..."
    cp "$PLIST_SRC" "$PLIST_DEST"

    # Try modern bootstrap first (macOS 12+), fall back to legacy load
    if launchctl bootstrap "$(_user_domain)" "$PLIST_DEST" 2>/dev/null; then
        :
    else
        launchctl load -w "$PLIST_DEST" 2>/dev/null || true
    fi

    # Wait up to 30 seconds for socket (rebuild can take ~20s for 2000+ nodes)
    local waited=0
    while [[ $waited -lt 30 ]]; do
        if [[ -S "$SOCKET" ]]; then
            sleep 0.5
            success "Synapse daemon started."
            return
        fi
        sleep 1
        (( waited++ ))
    done
    error "Daemon did not start within 30 seconds. Check logs: $LOG_FILE"
    exit 1
}

cmd_stop() {
    info "Stopping Synapse daemon..."
    # Try modern bootout first
    if launchctl bootout "$(_user_domain)/$PLIST_LABEL" 2>/dev/null; then
        :
    elif [[ -f "$PLIST_DEST" ]]; then
        launchctl unload -w "$PLIST_DEST" 2>/dev/null || true
    fi
    rm -f "$PLIST_DEST"
    rm -f "$SOCKET"
    # Also kill any manually-started daemon
    pkill -f "daemon.py" 2>/dev/null || true
    success "Daemon stopped."
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    echo -e "\n${BOLD}Synapse Status${RESET}"
    echo "─────────────────────────────"
    if _is_running; then
        local count
        count=$(_ping_daemon)
        echo -e "  Daemon      ${GREEN}● Running${RESET}"
        echo    "  Socket      $SOCKET"
        echo    "  Snippets    $count in memory fabric"
        echo    "  Model       SynapseEmbedder.mlpackage (INT4, ANE)"
        echo    "  Log         $LOG_FILE"
    else
        echo -e "  Daemon      ${RED}○ Not running${RESET}"
        echo    "  Run: $(basename "$0") start"
    fi
    echo ""
}

cmd_logs() {
    if [[ ! -f "$LOG_FILE" ]]; then
        warn "No log file found at $LOG_FILE. Start the daemon first."
        exit 1
    fi
    info "Tailing $LOG_FILE (Ctrl+C to exit)..."
    tail -f "$LOG_FILE"
}

cmd_reset() {
    warn "This will permanently delete all stored memories."
    read -r "REPLY?Are you sure? (yes/no): "
    if [[ "$REPLY" == "yes" ]]; then
        rm -f "$PROJECT_ROOT/data/synapse.index"
        rm -f "$PROJECT_ROOT/data/synapse.db"
        success "Memory store wiped. Restart the daemon to reinitialize."
    else
        info "Cancelled."
    fi
}

cmd_install() {
    local target="/usr/local/bin/synapse"
    info "Installing synapse CLI to $target ..."
    ln -sf "$SCRIPT_DIR/synapse" "$target"
    chmod +x "$SCRIPT_DIR/synapse"
    success "Installed. You can now run: synapse start"
}

# ── Main ───────────────────────────────────────────────────────────────────────

case "${1:-}" in
    start)   cmd_start   ;;
    stop)    cmd_stop    ;;
    restart) cmd_restart ;;
    status)  cmd_status  ;;
    logs)    cmd_logs    ;;
    reset)   cmd_reset   ;;
    install) cmd_install ;;
    *)
        echo -e "${BOLD}Synapse — On-Device Semantic Memory Fabric${RESET}"
        echo ""
        echo "Usage: $(basename "$0") <command>"
        echo ""
        echo "Commands:"
        echo "  start    Start the daemon via launchd"
        echo "  stop     Stop the daemon"
        echo "  restart  Restart the daemon"
        echo "  status   Show daemon status and snippet count"
        echo "  logs     Tail the daemon log"
        echo "  reset    Wipe all stored memories"
        echo "  install  Install synapse CLI to /usr/local/bin"
        exit 1
        ;;
esac
